<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>ShopPro | Modern Online Store</title>

<style>
/* =========================
   RESET
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f7f8fc;
    color: #111827;
}

button,
input,
select {
    font: inherit;
}

button {
    cursor: pointer;
}

a {
    text-decoration: none;
    color: inherit;
}


/* =========================
   HEADER
========================= */

header {
    position: sticky;
    top: 0;
    z-index: 1000;

    height: 75px;

    background: rgba(255,255,255,0.96);
    backdrop-filter: blur(12px);

    border-bottom: 1px solid #e5e7eb;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 6%;
}

.logo {
    font-size: 25px;
    font-weight: 900;
    color: #111827;
}

.logo span {
    color: #2563eb;
}

nav {
    display: flex;
    gap: 30px;
}

nav a {
    font-weight: 600;
    color: #4b5563;
}

nav a:hover {
    color: #2563eb;
}

.header-actions {
    display: flex;
    gap: 10px;
}

.icon-btn {
    width: 42px;
    height: 42px;

    border: none;
    border-radius: 50%;

    background: #f3f4f6;
}

.icon-btn:hover {
    background: #2563eb;
    color: white;
}

.cart-btn {
    position: relative;
}

.cart-count {
    position: absolute;

    top: -5px;
    right: -4px;

    width: 20px;
    height: 20px;

    background: #ef4444;
    color: white;

    border-radius: 50%;

    font-size: 11px;

    display: flex;
    align-items: center;
    justify-content: center;
}


/* =========================
   HERO
========================= */

.hero {
    min-height: 650px;

    padding: 80px 6%;

    display: grid;
    grid-template-columns: 1.1fr 0.9fr;

    align-items: center;

    background:
        radial-gradient(
            circle at 80% 30%,
            #dbeafe,
            transparent 35%
        ),
        linear-gradient(
            135deg,
            #eff6ff,
            #ffffff
        );
}

.hero-content {
    max-width: 650px;
}

.hero-label {
    display: inline-block;

    padding: 8px 15px;

    border-radius: 50px;

    background: #dbeafe;
    color: #1d4ed8;

    font-size: 13px;
    font-weight: 800;

    margin-bottom: 20px;
}

.hero h1 {
    font-size: clamp(45px, 6vw, 75px);
    line-height: 1.02;

    margin-bottom: 25px;
}

.hero h1 span {
    color: #2563eb;
}

.hero p {
    color: #6b7280;
    font-size: 18px;
    max-width: 570px;
}

.hero-buttons {
    display: flex;
    gap: 15px;

    margin-top: 35px;
}

.btn-primary,
.btn-secondary {
    padding: 15px 25px;

    border-radius: 9px;

    font-weight: 800;

    transition: 0.3s;
}

.btn-primary {
    background: #2563eb;
    color: white;
}

.btn-primary:hover {
    background: #1d4ed8;
    transform: translateY(-2px);
}

.btn-secondary {
    background: white;
    border: 1px solid #d1d5db;
}

.btn-secondary:hover {
    border-color: #2563eb;
    color: #2563eb;
}


/* =========================
   HERO PRODUCT DISPLAY
========================= */

.hero-visual {
    display: flex;
    justify-content: center;
    align-items: center;
}

.product-showcase {
    width: 360px;
    height: 430px;

    border-radius: 35px;

    background:
        linear-gradient(
            145deg,
            #2563eb,
            #1e3a8a
        );

    box-shadow:
        0 30px 70px rgba(37,99,235,0.3);

    color: white;

    padding: 35px;

    position: relative;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    transform: rotate(2deg);
}

.product-icon {
    font-size: 110px;
    margin-bottom: 25px;
}

.product-showcase h2 {
    font-size: 32px;
}

.product-showcase p {
    color: #dbeafe;
    text-align: center;
    margin-top: 10px;
}

.price-badge {
    position: absolute;

    right: -20px;
    top: 40px;

    background: white;
    color: #111827;

    padding: 15px 20px;

    border-radius: 12px;

    box-shadow: 0 15px 30px rgba(0,0,0,0.15);

    font-weight: 900;
}


/* =========================
   BENEFITS
========================= */

.benefits {
    background: white;

    padding: 35px 6%;

    display: grid;
    grid-template-columns: repeat(4,1fr);

    gap: 25px;
}

.benefit {
    display: flex;
    gap: 15px;
    align-items: center;
}

.benefit-icon {
    width: 50px;
    height: 50px;

    border-radius: 12px;

    background: #eff6ff;
    color: #2563eb;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 22px;
}

.benefit h3 {
    font-size: 15px;
}

.benefit p {
    color: #6b7280;
    font-size: 13px;
}


/* =========================
   SECTION
========================= */

.section {
    padding: 90px 6%;
}

.section-heading {
    text-align: center;
    margin-bottom: 45px;
}

.section-heading small {
    color: #2563eb;
    font-weight: 900;
    letter-spacing: 2px;
}

.section-heading h2 {
    font-size: 40px;
    margin-top: 8px;
}


/* =========================
   CATEGORIES
========================= */

.categories {
    display: grid;
    grid-template-columns: repeat(4,1fr);

    gap: 20px;
}

.category {
    border: none;

    background: white;

    border-radius: 18px;

    padding: 35px 20px;

    text-align: center;

    box-shadow: 0 8px 25px rgba(0,0,0,0.05);

    transition: 0.3s;
}

.category:hover {
    transform: translateY(-8px);

    box-shadow:
        0 20px 40px rgba(0,0,0,0.1);
}

.category-icon {
    font-size: 45px;
    margin-bottom: 15px;
}

.category h3 {
    margin-bottom: 5px;
}

.category p {
    color: #6b7280;
    font-size: 14px;
}


/* =========================
   PRODUCTS
========================= */

.products-section {
    background: white;
}

.products-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;

    margin-bottom: 30px;
}

.search {
    width: 300px;

    padding: 13px 15px;

    border: 1px solid #d1d5db;

    border-radius: 9px;

    outline: none;
}

.search:focus {
    border-color: #2563eb;
}

.sort {
    padding: 13px;

    border: 1px solid #d1d5db;

    border-radius: 9px;

    background: white;
}

.products {
    display: grid;

    grid-template-columns:
        repeat(4, minmax(0,1fr));

    gap: 25px;
}

.product-card {
    background: white;

    border: 1px solid #e5e7eb;

    border-radius: 17px;

    overflow: hidden;

    transition: 0.3s;
}

.product-card:hover {
    transform: translateY(-6px);

    box-shadow:
        0 20px 40px rgba(0,0,0,0.1);
}

.product-image {
    height: 230px;

    background: #f3f4f6;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 80px;
}

.product-details {
    padding: 20px;
}

.category-name {
    color: #6b7280;

    font-size: 12px;

    text-transform: uppercase;
}

.product-details h3 {
    margin: 5px 0 10px;
}

.stars {
    color: #f59e0b;

    font-size: 14px;
}

.product-bottom {
    margin-top: 15px;

    display: flex;

    justify-content: space-between;

    align-items: center;
}

.product-price {
    font-size: 20px;
    font-weight: 900;
}

.add-button {
    width: 42px;
    height: 42px;

    border: none;

    border-radius: 50%;

    background: #2563eb;

    color: white;

    font-size: 20px;
}

.add-button:hover {
    background: #1d4ed8;
}


/* =========================
   PROMO
========================= */

.promo {
    margin: 80px 6%;

    padding: 60px;

    border-radius: 25px;

    background:
        linear-gradient(
            120deg,
            #111827,
            #1e3a8a
        );

    color: white;

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 30px;
}

.promo h2 {
    font-size: 40px;
}

.promo p {
    color: #d1d5db;

    margin-top: 10px;
}

.promo-button {
    padding: 15px 25px;

    border: none;

    background: white;

    color: #111827;

    border-radius: 9px;

    font-weight: 900;
}


/* =========================
   FOOTER
========================= */

footer {
    background: #111827;

    color: white;

    padding: 70px 6% 25px;
}

.footer-grid {
    display: grid;

    grid-template-columns:
        2fr 1fr 1fr 1.5fr;

    gap: 50px;
}

.footer-column h3 {
    margin-bottom: 20px;
}

.footer-column a {
    display: block;

    color: #9ca3af;

    margin-bottom: 10px;
}

.footer-column a:hover {
    color: white;
}

.footer-column p {
    color: #9ca3af;
}

.socials {
    display: flex;
    gap: 10px;
    margin-top: 20px;
}

.socials a {
    width: 40px;
    height: 40px;

    background: #1f2937;

    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;
}

.copyright {
    border-top: 1px solid #374151;

    margin-top: 50px;

    padding-top: 20px;

    text-align: center;

    color: #9ca3af;
}


/* =========================
   CART
========================= */

.cart-overlay {
    position: fixed;

    inset: 0;

    background: rgba(0,0,0,0.55);

    z-index: 3000;

    display: none;
}

.cart-overlay.open {
    display: block;
}

.cart {
    position: absolute;

    right: 0;
    top: 0;

    height: 100%;

    width: min(450px,100%);

    background: white;

    padding: 25px;

    overflow-y: auto;
}

.cart-header {
    display: flex;

    justify-content: space-between;

    align-items: center;

    padding-bottom: 20px;

    border-bottom: 1px solid #e5e7eb;
}

.close {
    border: none;

    background: #f3f4f6;

    width: 40px;
    height: 40px;

    border-radius: 50%;
}

.cart-item {
    display: flex;

    gap: 15px;

    padding: 18px 0;

    border-bottom: 1px solid #e5e7eb;
}

.cart-item-image {
    width: 60px;
    height: 60px;

    border-radius: 10px;

    background: #eff6ff;

    display: flex;

    align-items: center;
    justify-content: center;

    font-size: 25px;
}

.cart-item-info {
    flex: 1;
}

.cart-item-info p {
    color: #6b7280;
    font-size: 14px;
}

.remove {
    border: none;

    background: transparent;

    color: #ef4444;
}

.cart-footer {
    margin-top: 25px;
}

.cart-total {
    display: flex;

    justify-content: space-between;

    font-size: 20px;

    margin-bottom: 20px;
}

.checkout {
    width: 100%;

    padding: 15px;

    border: none;

    border-radius: 9px;

    background: #2563eb;

    color: white;

    font-weight: 900;
}


/* =========================
   NOTIFICATION
========================= */

.notification {
    position: fixed;

    right: 25px;
    bottom: 25px;

    z-index: 5000;

    background: #111827;

    color: white;

    padding: 15px 20px;

    border-radius: 10px;

    transform: translateY(100px);

    opacity: 0;

    transition: 0.3s;
}

.notification.show {
    transform: translateY(0);

    opacity: 1;
}


/* =========================
   MOBILE
========================= */

@media(max-width:1000px) {

    nav {
        display: none;
    }

    .hero {
        grid-template-columns: 1fr;

        text-align: center;
    }

    .hero p {
        margin: auto;
    }

    .hero-buttons {
        justify-content: center;
    }

    .hero-visual {
        margin-top: 50px;
    }

    .benefits {
        grid-template-columns: repeat(2,1fr);
    }

    .categories {
        grid-template-columns: repeat(2,1fr);
    }

    .products {
        grid-template-columns: repeat(2,1fr);
    }

    .footer-grid {
        grid-template-columns: repeat(2,1fr);
    }
}


@media(max-width:600px) {

    header {
        padding: 0 5%;
    }

    .logo {
        font-size: 21px;
    }

    .hero {
        padding: 60px 5%;
    }

    .hero h1 {
        font-size: 46px;
    }

    .hero-buttons {
        flex-direction: column;
    }

    .product-showcase {
        width: 290px;
        height: 350px;
    }

    .benefits {
        grid-template-columns: 1fr;

        padding: 30px 5%;
    }

    .section {
        padding: 60px 5%;
    }

    .categories,
    .products {
        grid-template-columns: 1fr;
    }

    .products-toolbar {
        flex-direction: column;

        align-items: stretch;

        gap: 15px;
    }

    .search {
        width: 100%;
    }

    .promo {
        margin: 50px 5%;

        padding: 35px 25px;

        flex-direction: column;

        text-align: center;
    }

    .promo h2 {
        font-size: 30px;
    }

    .footer-grid {
        grid-template-columns: 1fr;
    }
}
</style>
</head>


